<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gym.view.Ekran2Controller"
      spacing="0" style="-fx-background-color: #f0f0f0;">

    <!-- Header -->
    <VBox style="-fx-background-color: #4a90e2; -fx-padding: 20;">
        <Label text="System Zarządzania Siłownią"
               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Label text="Krok 2 z 3: Potwierdzenie i płatność"
               style="-fx-text-fill: #e3f2fd; -fx-font-size: 14px;"/>
    </VBox>

    <!-- Content w ScrollPane -->
    <ScrollPane fitToWidth="true" fitToHeight="true"
                style="-fx-background: #f0f0f0; -fx-background-color: #f0f0f0;">
        <VBox spacing="15" style="-fx-padding: 20;">

            <!-- Podsumowanie -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;">
                <Label text="Podsumowanie rezerwacji" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <GridPane hgap="15" vgap="10">
                    <Label text="Strefa:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblStrefa" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblData" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Godziny:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblGodziny" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
                <Separator/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Koszt strefy:" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblKosztStrefy"/>
                </HBox>
            </VBox>

            <!-- Opcje -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;">
                <Label text="Dodatkowe opcje" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

                <!-- Trener -->
                <VBox spacing="10">
                    <CheckBox fx:id="chkTrener" text="Dodać trenera personalnego?"/>
                    <ComboBox fx:id="cmbTrener" promptText="Wybierz trenera..." maxWidth="Infinity" disable="true"/>
                    <Label fx:id="lblKosztTrenera" visible="false" wrapText="true" maxWidth="Infinity"
                           style="-fx-background-color: #fff3cd; -fx-padding: 10; -fx-background-radius: 5; -fx-text-fill: #856404;"/>
                </VBox>

                <Separator/>

                <!-- Karnet -->
                <VBox spacing="10">
                    <CheckBox fx:id="chkKarnet" text="Użyć karnetu (zniżka 50%)?" disable="true"/>
                    <Label fx:id="lblKarnetInfo" wrapText="true" maxWidth="Infinity"/>
                    <Label fx:id="lblNowyKoszt" visible="false" wrapText="true" maxWidth="Infinity"
                           style="-fx-background-color: #fff3cd; -fx-padding: 10; -fx-background-radius: 5; -fx-text-fill: #856404;"/>
                </VBox>
            </VBox>

            <!-- Koszt total -->
            <VBox spacing="10" style="-fx-background-color: #4a90e2; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Strefa:" style="-fx-text-fill: white;"/>
                    <Label fx:id="lblStrefaKoszt" style="-fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Trener:" style="-fx-text-fill: white;"/>
                    <Label fx:id="lblTrenerKoszt" text="0 PLN" style="-fx-text-fill: white;"/>
                </HBox>
                <Separator style="-fx-background-color: white;"/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="RAZEM:" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblRazem" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Płatność -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;">
                <Label text="Metoda płatności" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <RadioButton fx:id="rbKarta" text="Karta płatnicza" selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="metodaGroup"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="rbPrzelew" text="Przelew bankowy" toggleGroup="$metodaGroup"/>
            </VBox>

            <!-- Error -->
            <Label fx:id="lblError" visible="false"
                   style="-fx-text-fill: red; -fx-font-weight: bold;"/>

            <!-- Przyciski -->
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 20 0;">
                <Button text="Wstecz" onAction="#handleWstecz"
                        style="-fx-font-size: 14px; -fx-padding: 10 25; -fx-background-color: #e0e0e0;"/>
                <Button text="Anuluj" onAction="#handleAnuluj"
                        style="-fx-font-size: 14px; -fx-padding: 10 25; -fx-background-color: #e0e0e0;"/>
                <Button text="Zapłać" onAction="#handleZaplac"
                        style="-fx-font-size: 14px; -fx-padding: 10 25; -fx-background-color: #28a745; -fx-text-fill: white;"/>
            </HBox>

        </VBox>
    </ScrollPane>

</VBox>