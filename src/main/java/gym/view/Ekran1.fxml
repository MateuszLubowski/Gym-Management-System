<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gym.view.Ekran1Controller"
      spacing="15" style="-fx-background-color: #f0f0f0;">

    <!-- Header -->
    <VBox style="-fx-background-color: #4a90e2; -fx-padding: 20;">
        <Label text="System Zarządzania Siłownią"
               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Label text="Krok 1 z 3: Wybór strefy i terminu"
               style="-fx-text-fill: #e3f2fd; -fx-font-size: 14px;"/>
    </VBox>

    <!-- Content -->
    <VBox spacing="15" style="-fx-padding: 20;">

        <!-- Panel 1: Strefa -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;">
            <Label text="1. Wybierz strefę" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <ComboBox fx:id="cmbStrefa" promptText="Wybierz strefę..." maxWidth="Infinity"/>
        </VBox>

        <!-- Panel 2: Data -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;">
            <Label text="2. Wybierz datę" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
            <Label fx:id="lblDataInfo" visible="false"
                   style="-fx-background-color: #d4edda; -fx-padding: 10; -fx-background-radius: 5; -fx-text-fill: #155724;"/>
        </VBox>

        <!-- Panel 3: Przedział -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;">
            <Label text="3. Wybierz przedział czasowy" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <ComboBox fx:id="cmbPrzedzial" promptText="Wybierz przedział..." maxWidth="Infinity"/>
        </VBox>

        <!-- Error -->
        <Label fx:id="lblError" visible="false"
               style="-fx-text-fill: red; -fx-font-weight: bold; -fx-font-size: 14px;"/>

        <!-- Przyciski -->
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
            <Button text="Anuluj" onAction="#handleAnuluj"
                    style="-fx-font-size: 14px; -fx-padding: 10 25; -fx-background-color: #e0e0e0;"/>
            <Button fx:id="btnDalej" text="Dalej" onAction="#handleDalej" disable="true"
                    style="-fx-font-size: 14px; -fx-padding: 10 25; -fx-background-color: #4a90e2; -fx-text-fill: white;"/>
        </HBox>

    </VBox>

</VBox>
